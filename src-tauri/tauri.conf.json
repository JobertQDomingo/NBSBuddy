{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NBSBuddy",
  "version": "../package.json",
  "identifier": "io.github.jobertqdomingo.nbsbuddy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NBSBuddy",
        "width": 1133,
        "height": 778,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Jobert Domingo",
    "shortDescription": "File OB + CS in NBS and check your payroll period before cutoff",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5MjY3QTA4RUJDNjVCMDIKUldRQ1c4YnJDSG9tV1R3WmF1K3NVSFhyOTJLN3F3Um5jZ3E5cFBXc0NqQ05UeEd2d3EvWEZmeTgK",
      "endpoints": ["https://github.com/JobertQDomingo/NBSBuddy/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
